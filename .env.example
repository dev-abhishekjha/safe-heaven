# ---------------------------------------------------------------------------
# Safe Heaven Accomodations — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Public base URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Database (Supabase Postgres) ------------------------------------------
# The app parses this URI into host / port / user / database and IGNORES the
# password inside it. Put the real password in DATABASE_PASSWORD below.
#
# Why: node-postgres lets a connection string override any field passed beside
# it, so a stale password in the URI silently wins over DATABASE_PASSWORD and
# you get "28P01 password authentication failed" with nothing to explain it.
# Passwords also cannot safely contain @ : / or ? inside a URI, and # starts a
# comment in this file — DATABASE_PASSWORD has neither problem.
#
# Supabase dashboard -> Connect -> Session pooler. Keep the tenant-qualified
# username (postgres.<project-ref>) exactly as shown.
DATABASE_URI="postgresql://postgres.<project-ref>:ignored@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional. Only needed if DATABASE_URI points at Supabase's TRANSACTION
# pooler (port 6543), which suits serverless but is wrong for migrations.
# Set this to the SESSION pooler URL (port 5432) and migrations will use it.
# Leave empty if DATABASE_URI is already the session pooler.
DATABASE_DIRECT_URI=""

# The real password, written literally. Quote it — # would start a comment.
# Reset it under Supabase -> Project Settings -> Database -> Database password.
DATABASE_PASSWORD="your-password-here"

# --- Payload CMS -----------------------------------------------------------
# Random string, 32+ characters. Rotating this invalidates all admin sessions.
PAYLOAD_SECRET=

# --- Media storage (Supabase Storage, S3-compatible) -----------------------
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
# Verified sending domain. Leave blank until a domain is set up — applicant
# confirmation emails stay disabled while this is empty.
RESEND_FROM=
# Where new booking/contact enquiries are notified
LEAD_NOTIFY_EMAIL=abhi108akj@gmail.com

# --- Contact ---------------------------------------------------------------
# Digits only, with country code, e.g. 918273458926
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Analytics (added in T21) ----------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
